digraph BPMN {
  graph [rankdir=LR, bgcolor="white", pad=.14, nodesep=.18, ranksep=.22,
         splines=polyline, fontname="DejaVu Sans", labelloc=t, fontsize=17,
         compound=true, newrank=true];
  node [fontname="DejaVu Sans", fontsize=14, color="black", fontcolor="black",
        style="filled", fillcolor="white", margin=".12,.08", penwidth=1.2];
  edge [fontname="DejaVu Sans", fontsize=12, color="black", fontcolor="black",
        arrowsize=.72, penwidth=1.1];
  label="ed01 · miembros · etapa 2: regla para c.wnry";
  subgraph cluster_pool { label="POOL · consulta de archivo"; color=black; penwidth=1.3; margin=11;
    subgraph cluster_special { label="CARRIL · secuencia del programa"; color=gray45; style="rounded"; margin=9;
      s [shape=circle, label="", xlabel="Nombre = c.wnry", fixedsize=true, width=.36];
      attr [shape=box, label="GetFileAttributesA", style="rounded,filled"];
      g [shape=diamond, label="¿Archivo existe?"];
      skip [shape=box, label="Sí: omitir extracción", style="rounded,filled"];
      extract [shape=box, label="No: pedir extracción", style="rounded,filled"];
      end [shape=doublecircle, label="", xlabel="Volver al bucle", fixedsize=true, width=.36];
    }
  s -> attr;
  attr -> g;
  g -> skip [label="Sí"];
  g -> extract [label="No"];
  skip -> end;
  extract -> end;
  }
}
