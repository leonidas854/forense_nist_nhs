digraph BPMN {
  graph [rankdir=LR, bgcolor="white", pad=.12, nodesep=.16, ranksep=.22,
         splines=polyline, fontname="DejaVu Sans", labelloc=t, fontsize=16,
         compound=true, newrank=true];
  node [fontname="DejaVu Sans", fontsize=14, color="black", fontcolor="black",
        style="filled", fillcolor="white", margin=".10,.07", penwidth=1.2];
  edge [fontname="DejaVu Sans", fontsize=12, color="black", fontcolor="black",
        arrowsize=.7, penwidth=1.1];
  label="ec1383 · PlayGame · en qué orden solicita las acciones";
  subgraph cluster_pool { label="POOL · exportación 1800011a4"; color=black; penwidth=1.3; margin=11;
    subgraph cluster_code { label="CARRIL · flujo de la exportación"; color=gray45; style="rounded"; margin=9;
      s [shape=circle, label="", xlabel="Si alguien la invoca", fixedsize=true, width=.36];
      path [shape=box, label="Formar ruta
mssecsvc.exe", style="rounded,filled"];
      extract [shape=box, label="Llamar extractor
W/101", style="rounded,filled"];
      launch [shape=box, label="Llamar helper
CreateProcessA", style="rounded,filled"];
      end [shape=doublecircle, label="", xlabel="Retorno 0", fixedsize=true, width=.36];
    }
  s -> path;
  path -> extract;
  extract -> launch;
  launch -> end;
  }
}
