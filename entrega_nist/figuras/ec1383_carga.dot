digraph BPMN {
  graph [rankdir=LR, bgcolor="white", pad=.14, nodesep=.18, ranksep=.22,
         splines=polyline, fontname="DejaVu Sans", labelloc=t, fontsize=17,
         compound=true, newrank=true];
  node [fontname="DejaVu Sans", fontsize=14, color="black", fontcolor="black",
        style="filled", fillcolor="white", margin=".12,.08", penwidth=1.2];
  edge [fontname="DejaVu Sans", fontsize=12, color="black", fontcolor="black",
        arrowsize=.72, penwidth=1.1];
  label="ec1383 · W/101 · etapa 2: cargar y validar datos";
  subgraph cluster_pool { label="POOL · LoadResource y LockResource"; color=black; penwidth=1.3; margin=11;
    subgraph cluster_lane { label="CARRIL · secuencia de comprobaciones"; color=gray45; style="rounded"; margin=9;
      s [shape=circle, label="", xlabel="HRSRC válida", fixedsize=true, width=.36];
      load [shape=box, label="LoadResource", style="rounded,filled"];
      g1 [shape=diamond, label="¿Datos
no NULL?"];
      lock [shape=box, label="LockResource", style="rounded,filled"];
      g2 [shape=diamond, label="¿Puntero
no NULL?"];
      end [shape=doublecircle, label="", xlabel="Sí: medir recurso", fixedsize=true, width=.36];
    }
  s -> load;
  load -> g1;
  g1 -> lock [label="Sí"];
  lock -> g2;
  g2 -> end [label="Sí"];
  }
}
