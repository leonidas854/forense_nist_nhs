digraph BPMN {
  graph [rankdir=LR, bgcolor="white", pad=.14, nodesep=.18, ranksep=.22,
         splines=polyline, fontname="DejaVu Sans", labelloc=t, fontsize=17,
         compound=true, newrank=true];
  node [fontname="DejaVu Sans", fontsize=14, color="black", fontcolor="black",
        style="filled", fillcolor="white", margin=".12,.08", penwidth=1.2];
  edge [fontname="DejaVu Sans", fontsize=12, color="black", fontcolor="black",
        arrowsize=.72, penwidth=1.1];
  label="u.wnry · proceso · etapa 2A: esperar resultado";
  subgraph cluster_pool { label="POOL · continuación del auxiliar"; color=black; penwidth=1.3; margin=11;
    subgraph cluster_lane { label="CARRIL · secuencia del código"; color=gray45; style="rounded"; margin=9;
      s [shape=circle, label="", xlabel="Parámetro de espera != 0", fixedsize=true, width=.36];
      api [shape=box, label="WaitForSingleObject", style="rounded,filled"];
      g [shape=diamond, label="¿Resultado no cero?"];
      yes [shape=doublecircle, label="", xlabel="Sí: ver figura
“terminación”", fixedsize=true, width=.36];
      no [shape=doublecircle, label="", xlabel="No: cerrar handles", fixedsize=true, width=.36];
    }
  s -> api;
  api -> g;
  g -> yes [label="Sí"];
  g -> no [label="No"];
  }
}
