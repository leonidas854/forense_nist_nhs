digraph BPMN {
  graph [rankdir=LR, bgcolor="white", pad=.14, nodesep=.18, ranksep=.22,
         splines=polyline, fontname="DejaVu Sans", labelloc=t, fontsize=17,
         compound=true, newrank=true];
  node [fontname="DejaVu Sans", fontsize=14, color="black", fontcolor="black",
        style="filled", fillcolor="white", margin=".12,.08", penwidth=1.2];
  edge [fontname="DejaVu Sans", fontsize=12, color="black", fontcolor="black",
        arrowsize=.72, penwidth=1.1];
  label="ec1383 · W/101 · etapa 2: medir y leer L";
  subgraph cluster_pool { label="POOL · longitud del contenido"; color=black; penwidth=1.3; margin=11;
    subgraph cluster_data { label="CARRIL · secuencia del programa"; color=gray45; style="rounded"; margin=9;
      s [shape=circle, label="", xlabel="Puntero válido", fixedsize=true, width=.36];
      size [shape=box, label="SizeofResource", style="rounded,filled"];
      g [shape=diamond, label="¿Tamaño > 0?"];
      read [shape=box, label="Leer DWORD inicial L", style="rounded,filled"];
      end [shape=doublecircle, label="", xlabel="Pasar a escritura", fixedsize=true, width=.36];
    }
  s -> size;
  size -> g;
  g -> read [label="Sí"];
  read -> end;
  }
}
