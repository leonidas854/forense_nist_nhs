digraph BPMN {
  graph [rankdir=LR, bgcolor="white", pad=.14, nodesep=.18, ranksep=.22,
         splines=polyline, fontname="DejaVu Sans", labelloc=t, fontsize=17,
         compound=true, newrank=true];
  node [fontname="DejaVu Sans", fontsize=14, color="black", fontcolor="black",
        style="filled", fillcolor="white", margin=".12,.08", penwidth=1.2];
  edge [fontname="DejaVu Sans", fontsize=12, color="black", fontcolor="black",
        arrowsize=.72, penwidth=1.1];
  label="ed01 · XIA/2058 · etapa 1: localizar el recurso";
  subgraph cluster_pool { label="POOL · FindResourceA"; color=black; penwidth=1.3; margin=11;
    subgraph cluster_program { label="CARRIL · secuencia del programa"; color=gray45; style="rounded"; margin=9;
      s [shape=circle, label="", xlabel="Entrada 00401dab", fixedsize=true, width=.36];
      find [shape=box, label="Buscar XIA / ID 2058", style="rounded,filled"];
      g [shape=diamond, label="¿Referencia válida?"];
      end [shape=doublecircle, label="", xlabel="Sí: cargar", fixedsize=true, width=.36];
    }
  s -> find;
  find -> g;
  g -> end [label="Sí"];
  }
}
